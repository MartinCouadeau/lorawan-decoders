# --- dependencies -----------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins

# --- build output -----------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# --- test and coverage output ----------------------------------------------
coverage/
.nyc_output/
.vitest-cache/
*.lcov

# --- logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- secrets and local config ----------------------------------------------
# Nothing in this project needs an API key, but the day someone adds a script
# that does, this rule is the difference between a mistake and an incident.
.env
.env.*
!.env.example
*.pem
*.key

# --- packaging artifacts ----------------------------------------------------
*.tgz
.npm/

# --- editors and OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- deliberately NOT ignored ----------------------------------------------
# package-lock.json is committed on purpose. It pins the exact dependency tree
# so CI, contributors and this machine install identical versions, and the CI
# workflow runs `npm ci`, which fails without it. npm ignores a dependency's
# lockfile, so it never affects anyone installing this package.
